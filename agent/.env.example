# Телефон как в приложении: 9XXXXXXXXX / 79XXXXXXXXX / +79XXXXXXXXX
WEOL_LOGIN=9001234567
WEOL_PASSWORD=

# Слушать снаружи
HTTP_HOST=0.0.0.0
HTTP_PORT=8787

# Как печатать ссылки в лог (IP или домен сервера)
PUBLIC_BASE_URL=http://YOUR_SERVER_IP:8787

# Секретный сегмент URL (≥24 символа). Сгенерировать:
#   openssl rand -hex 24
# Ссылки будут вида:
#   http://SERVER:8787/<PUBLIC_PATH>/in
#   http://SERVER:8787/<PUBLIC_PATH>/out
PUBLIC_PATH=REPLACE_WITH_openssl_rand_hex_24_output_here

# Лимит: суммарно по in+out. Больше N за минуту → оба эндпойнта lock на RATE_LOCK_SECONDS
RATE_MAX_PER_MINUTE=10
RATE_LOCK_SECONDS=300

# Участок и устройства
DEFAULT_PLOT=500
DEVICE_IN=35
DEVICE_OUT=36

# Keepalive сессии Bitrix (минуты)
KEEPALIVE_MINUTES=8

HEADLESS=true
BASE_URL=https://app.weol.ru
