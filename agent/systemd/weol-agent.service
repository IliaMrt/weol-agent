[Unit]
Description=WEOl Playwright gate agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=weol
Group=weol
WorkingDirectory=/opt/weol-agent/agent
EnvironmentFile=/opt/weol-agent/agent/.env
ExecStart=/usr/bin/node /opt/weol-agent/agent/src/index.js
Restart=on-failure
RestartSec=10
# Chromium иногда хочет больше открытых файлов
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
